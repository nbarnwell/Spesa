# Google OAuth 2.0 / OpenID Connect (Web client — also used by the server for token validation)
VITE_OIDC_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_OIDC_REDIRECT_URI=http://localhost:5174/auth/callback
# Server only — never prefix with VITE_. Copy from the same OAuth client in Google Cloud Console.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server
PORT=5174
# Rate limit for POST /auth/token, per client IP per instance
# AUTH_RATE_LIMIT_PER_MINUTE=30
# Number of reverse-proxy hops in front of the app (so the rate limit sees real client IPs)
# TRUST_PROXY=1
# Postgres (defaults match docker-compose.yml; run `npm run db:up`)
# DATABASE_URL=postgres://spesa:spesa@localhost:5432/spesa
# CA certificate (PEM) for managed Postgres that uses a private CA
# DATABASE_CA_CERT=
# DB_POOL_MAX=10
# Used by `npm test`
# TEST_DATABASE_URL=postgres://spesa:spesa@localhost:5432/spesa_test

# Optional: only if API is hosted separately from the PWA
# VITE_BFF_BASE_URL=https://api.example.com
